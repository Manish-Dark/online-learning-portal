{
    "version": 2,
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist",
                "installCommand": "npm install"
            }
        }
    ],
    "routes": [
        {
            "src": "/robots.txt",
            "dest": "/client/public/robots.txt"
        },
        {
            "src": "/sitemap.xml",
            "dest": "/client/public/sitemap.xml"
        },
        {
            "src": "/api/(.*)",
            "dest": "/server/index.js"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/client/index.html"
        }
    ]
}